public/*.jpg
public/*.png
public/*.webp

# Docker & infra — rarely relevant
Dockerfile
docker-compose.yml

# Type-gen artifacts — derived, not authored
.nuxt/components.d.ts
.nuxt/imports.d.ts
.nuxt/nuxt.d.ts
