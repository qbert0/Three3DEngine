{"file":"Avatar-0HPRhFHn.js","mappings":";;;;;;;;;;;;;AAmBA,UAAM,QAAQ;AAKd,UAAM,cAAsC;AAAA,MAC1C,IAAI;AAAA,MACJ,IAAI;AAAA,MACJ,IAAI;AAAA,MACJ,IAAI;AAAA,MACJ,IAAI;AAAA,IAAA;AAGN,UAAM,eAAuC;AAAA,MAC3C,QAAQ;AAAA,MACR,QAAQ;AAAA,IAAA;AAGV,UAAM,WAAW,SAAS,MAAM;AAC9B,UAAI,CAAC,MAAM,KAAM,QAAO;AACxB,YAAM,QAAQ,MAAM,KAAK,KAAA,EAAO,MAAM,KAAK;AAC3C,aAAO,MAAM,UAAU,KAClB,MAAM,CAAC,EAAE,CAAC,IAAI,MAAM,MAAM,SAAS,CAAC,EAAE,CAAC,GAAG,YAAA,IAC3C,MAAM,CAAC,EAAE,MAAM,GAAG,CAAC,EAAE,YAAA;AAAA,IAC3B,CAAC;AAGD,UAAM,WAAW;AAAA,MACf;AAAA,MAAW;AAAA,MAAW;AAAA,MAAW;AAAA,MAAW;AAAA,MAC5C;AAAA,MAAW;AAAA,MAAW;AAAA,MAAW;AAAA,MAAW;AAAA,IAAA;AAE9C,UAAM,UAAU,SAAS,MAAM;AAC7B,UAAI,CAAC,MAAM,KAAM,QAAO,SAAS,CAAC;AAClC,YAAM,MAAM,MAAM,KAAK,MAAM,EAAE,EAAE,OAAO,CAAC,GAAG,MAAM,IAAI,EAAE,WAAW,CAAC,GAAG,CAAC,IAAI,SAAS;AACrF,aAAO,SAAS,GAAG;AAAA,IACrB,CAAC;AAED,UAAM,WAAW,SAAS,MAAM,CAAC,CAAC,MAAM,GAAG;;;QAKtC,OAAK;AAAA;UAA2G,YAAY,QAAA,IAAI;AAAA,UAAS,aAAa,QAAA,KAAK;AAAA,QAAA;AAAA,QAK3J,OAAK,CAAG,SAAA,QAAQ,EAAA,iBAAsB,QAAA,yBAA2B;AAAA,QACjE,cAAY,QAAA,QAAQ,QAAA;AAAA,QACrB,MAAK;AAAA,MAAA;UAGG,SAAA,OAAQ;qBACbA,cAAA,OAAK,QAAA,GAAG,kBACR,OAAK,QAAA,QAAQ,QAAA,OAAG,EAAA;;;;WAIN,SAAA,OAAQ;yDAAwB,SAAA,KAAQ,CAAA,SAAA;AAAA;;;;;;;;;;;;;;","names":["_ssrRenderAttr"],"sources":["../../../../components/ui/Avatar.vue"],"sourcesContent":["<script setup lang=\"ts\">\n/**\n * UiAvatar — Astryx-style avatar with image + initials fallback.\n * https://astryx.atmeta.com/components/Avatar\n *\n * Sizes: xs | sm | md | lg | xl\n * Shape: circle | square\n */\n\nimport { computed } from 'vue';\n\ninterface Props {\n  src?: string;\n  name?: string;\n  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl';\n  shape?: 'circle' | 'square';\n  alt?: string;\n}\n\nconst props = withDefaults(defineProps<Props>(), {\n  size: 'md',\n  shape: 'circle',\n});\n\nconst sizeClasses: Record<string, string> = {\n  xs: 'h-6  w-6  text-[9px]',\n  sm: 'h-8  w-8  text-[11px]',\n  md: 'h-10 w-10 text-sm',\n  lg: 'h-12 w-12 text-base',\n  xl: 'h-16 w-16 text-lg',\n};\n\nconst shapeClasses: Record<string, string> = {\n  circle: 'rounded-full',\n  square: 'rounded-[--ui-radius-sm]',\n};\n\nconst initials = computed(() => {\n  if (!props.name) return '?';\n  const parts = props.name.trim().split(/\\s+/);\n  return parts.length >= 2\n    ? (parts[0][0] + parts[parts.length - 1][0]).toUpperCase()\n    : parts[0].slice(0, 2).toUpperCase();\n});\n\n// Deterministic background color from name\nconst bgColors = [\n  '#1f6f8b', '#3d5f43', '#a8583f', '#7c3aed', '#0891b2',\n  '#065f46', '#9d174d', '#92400e', '#1e40af', '#5b21b6',\n];\nconst bgColor = computed(() => {\n  if (!props.name) return bgColors[0];\n  const idx = props.name.split('').reduce((a, c) => a + c.charCodeAt(0), 0) % bgColors.length;\n  return bgColors[idx];\n});\n\nconst hasImage = computed(() => !!props.src);\n</script>\n\n<template>\n  <div\n    :class=\"[\n      'relative inline-flex shrink-0 items-center justify-center overflow-hidden font-semibold',\n      sizeClasses[size],\n      shapeClasses[shape],\n    ]\"\n    :style=\"!hasImage ? { backgroundColor: bgColor, color: '#fff' } : undefined\"\n    :aria-label=\"name || alt\"\n    role=\"img\"\n  >\n    <img\n      v-if=\"hasImage\"\n      :src=\"src\"\n      :alt=\"name || alt || ''\"\n      class=\"h-full w-full object-cover\"\n      @error=\"(e) => ((e.target as HTMLImageElement).style.display = 'none')\"\n    />\n    <span v-if=\"!hasImage\" aria-hidden=\"true\">{{ initials }}</span>\n    <!-- Status dot slot -->\n    <slot name=\"status\" />\n  </div>\n</template>\n"],"version":3}