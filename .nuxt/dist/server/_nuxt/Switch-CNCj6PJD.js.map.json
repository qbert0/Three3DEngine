{"file":"Switch-CNCj6PJD.js","mappings":";;;;;;;;;;;AAqBA,UAAM,UAAU,IAAI,KAAK;AAWzB,UAAM,kBAA0C;AAAA,MAC9C,KAAQ;AAAA,MACR,QAAQ;AAAA,MACR,MAAQ;AAAA,MACR,OAAQ;AAAA,IAAA;AAGV,UAAM,eAAuC;AAAA,MAC3C,KAAQ;AAAA,MACR,QAAQ;AAAA,MACR,MAAQ;AAAA,MACR,OAAQ;AAAA,IAAA;AAGV,UAAM,MAAM,WAAW,KAAK,OAAA,EAAS,SAAS,EAAE,EAAE,MAAM,GAAG,CAAC,CAAC;;mBAKzDA,eAAAC,WAAA,EAAA,OAAM,uBAAA,GAAsB,MAAA,CAAA,SAOtBC,cAAA,oBAAkB,QAAA,QAAU,MAAM,MAAS;;;UAcvC,QAAA,OAAO;qBACZA,cAAA,MAAI,GAAG;;;;;UAEqP,gBAAgB,QAAA,SAAS;AAAA,QAAA,sBAQnR,QAAA,OAAO;;UAGuD,aAAa,QAAA,SAAS;AAAA,QAAA;;;;;;;;;;;;;;;;;;;;;;;;;;ACnE/F,UAAM,QAAQ;AAQd,UAAM,MAAM,MAAM,MAAM,UAAU,KAAK,OAAA,EAAS,SAAS,EAAE,EAAE,MAAM,GAAG,CAAC,CAAC;AAExE,UAAM,UAAU;AAAA,MACd,IAAI,EAAE,OAAO,WAAa,OAAO,eAAe,WAAW,kBAAA;AAAA,MAC3D,IAAI,EAAE,OAAO,YAAa,OAAO,eAAgB,WAAW,gBAAA;AAAA,IAAgB;AAG9E,UAAM,IAAI,SAAS,MAAM,QAAQ,MAAM,IAAI,CAAC;;;QAKvC,KAAKC,MAAA,GAAA;AAAA,QACL,OAAK;AAAA;UAAkD,QAAA,WAAQ,kCAAA;AAAA,QAAA;AAAA,4BAO7DD,cAAA,MAAIC,MAAA,GAAA,CAAG,gCAGPD,cAAA,gBAAc,QAAA,UAAU,0BACd,QAAA,QAAQ,IAAA,cAAA;;;QAC0M,EAAA,MAAE;AAAA,QAAe,QAAA,aAAU,0BAAA;AAAA,MAAA;;;QAUxE,EAAA,MAAE;AAAA,QAAiB,QAAA,aAAa,EAAA,MAAE,YAAS;AAAA,MAAA;UASjN,QAAA,OAAK;iGAAgE,QAAA,KAAK,CAAA,SAAA;AAAA;;;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_ssrRenderAttr","_unref"],"sources":["../../../../components/ui/Tooltip.vue","../../../../components/ui/Switch.vue"],"sourcesContent":["<script setup lang=\"ts\">\n/**\n * UiTooltip — Astryx-style floating tooltip triggered on hover/focus.\n * https://astryx.atmeta.com/components/Tooltip\n *\n * Props: content, placement, delay\n */\n\nimport { ref, computed } from 'vue';\n\ninterface Props {\n  content: string;\n  placement?: 'top' | 'bottom' | 'left' | 'right';\n  delay?: number;\n}\n\nconst props = withDefaults(defineProps<Props>(), {\n  placement: 'top',\n  delay: 400,\n});\n\nconst visible = ref(false);\nlet showTimer: ReturnType<typeof setTimeout>;\n\nfunction show() {\n  showTimer = setTimeout(() => { visible.value = true; }, props.delay);\n}\nfunction hide() {\n  clearTimeout(showTimer);\n  visible.value = false;\n}\n\nconst positionClasses: Record<string, string> = {\n  top:    'bottom-full left-1/2 -translate-x-1/2 mb-2',\n  bottom: 'top-full left-1/2 -translate-x-1/2 mt-2',\n  left:   'right-full top-1/2 -translate-y-1/2 mr-2',\n  right:  'left-full top-1/2 -translate-y-1/2 ml-2',\n};\n\nconst arrowClasses: Record<string, string> = {\n  top:    'top-full left-1/2 -translate-x-1/2 border-l-transparent border-r-transparent border-b-transparent border-t-[#1c1c1c] dark:border-t-[#2d2d2d]',\n  bottom: 'bottom-full left-1/2 -translate-x-1/2 border-l-transparent border-r-transparent border-t-transparent border-b-[#1c1c1c] dark:border-b-[#2d2d2d]',\n  left:   'left-full top-1/2 -translate-y-1/2 border-t-transparent border-b-transparent border-r-transparent border-l-[#1c1c1c] dark:border-l-[#2d2d2d]',\n  right:  'right-full top-1/2 -translate-y-1/2 border-t-transparent border-b-transparent border-l-transparent border-r-[#1c1c1c] dark:border-r-[#2d2d2d]',\n};\n\nconst uid = `tooltip-${Math.random().toString(36).slice(2, 8)}`;\n</script>\n\n<template>\n  <div\n    class=\"relative inline-flex\"\n    @mouseenter=\"show\"\n    @mouseleave=\"hide\"\n    @focusin=\"show\"\n    @focusout=\"hide\"\n  >\n    <!-- Trigger -->\n    <div :aria-describedby=\"visible ? uid : undefined\">\n      <slot />\n    </div>\n\n    <!-- Tooltip bubble -->\n    <Transition\n      enter-active-class=\"transition duration-150 ease-out\"\n      enter-from-class=\"opacity-0 scale-95\"\n      enter-to-class=\"opacity-100 scale-100\"\n      leave-active-class=\"transition duration-100 ease-in\"\n      leave-from-class=\"opacity-100 scale-100\"\n      leave-to-class=\"opacity-0 scale-95\"\n    >\n      <div\n        v-if=\"visible\"\n        :id=\"uid\"\n        role=\"tooltip\"\n        :class=\"[\n          'absolute z-50 whitespace-nowrap pointer-events-none',\n          'rounded-[--ui-radius-sm] bg-[#1c1c1c] dark:bg-[#2d2d2d]',\n          'px-2.5 py-1.5 text-xs font-medium text-white',\n          'shadow-[--ui-shadow-medium]',\n          positionClasses[placement],\n        ]\"\n      >\n        {{ content }}\n        <!-- Arrow -->\n        <span\n          :class=\"[\n            'absolute h-0 w-0 border-4',\n            arrowClasses[placement],\n          ]\"\n        />\n      </div>\n    </Transition>\n  </div>\n</template>\n","<script setup lang=\"ts\">\n/**\n * UiSwitch — Astryx-style toggle switch.\n * https://astryx.atmeta.com/components/Switch\n *\n * v-model: boolean\n * Sizes: sm | md\n */\n\nimport { computed } from 'vue';\n\ninterface Props {\n  modelValue?: boolean;\n  disabled?: boolean;\n  size?: 'sm' | 'md';\n  label?: string;\n  id?: string;\n}\n\nconst props = withDefaults(defineProps<Props>(), {\n  modelValue: false,\n  disabled: false,\n  size: 'md',\n});\n\nconst emit = defineEmits<{ 'update:modelValue': [val: boolean] }>();\n\nconst uid = props.id ?? `switch-${Math.random().toString(36).slice(2, 8)}`;\n\nconst sizeMap = {\n  sm: { track: 'w-8 h-5',   thumb: 'h-3.5 w-3.5', translate: 'translate-x-3.5' },\n  md: { track: 'w-11 h-6',  thumb: 'h-4.5 w-4.5',  translate: 'translate-x-5' },\n};\n\nconst s = computed(() => sizeMap[props.size]);\n</script>\n\n<template>\n  <label\n    :for=\"uid\"\n    :class=\"[\n      'inline-flex items-center gap-3',\n      disabled ? 'opacity-50 cursor-not-allowed' : 'cursor-pointer',\n    ]\"\n  >\n    <!-- Track -->\n    <button\n      :id=\"uid\"\n      type=\"button\"\n      role=\"switch\"\n      :aria-checked=\"modelValue\"\n      :disabled=\"disabled\"\n      :class=\"[\n        'relative shrink-0 rounded-full transition-colors duration-[--ui-transition-base]',\n        'outline-none focus-visible:ring-2 focus-visible:ring-offset-1 focus-visible:ring-[--ui-color-brand]',\n        s.track,\n        modelValue ? 'bg-[--ui-color-brand]' : 'bg-[--ui-color-bg-muted] ring-1 ring-[--ui-color-border]',\n      ]\"\n      @click=\"!disabled && emit('update:modelValue', !modelValue)\"\n    >\n      <!-- Thumb -->\n      <span\n        :class=\"[\n          'absolute top-1/2 left-0.5 -translate-y-1/2 rounded-full bg-white shadow-sm',\n          'transition-transform duration-[--ui-transition-base]',\n          s.thumb,\n          modelValue ? s.translate : 'translate-x-0',\n        ]\"\n      />\n    </button>\n    <!-- Label -->\n    <span v-if=\"label\" class=\"text-sm text-[--ui-color-text-primary] select-none\">{{ label }}</span>\n    <slot />\n  </label>\n</template>\n"],"version":3}