{"file":"Skeleton-BO-0Zy5d.js","mappings":";;;;;;;;;;;;AAaA,UAAM,QAAQ;AAKd,UAAM,iBAAyC;AAAA,MAC7C,MAAM;AAAA,MACN,IAAM;AAAA,MACN,IAAM;AAAA,MACN,MAAM;AAAA,IAAA;AAGR,UAAM,QAAQ,CAAC,MAAM,OAAO;AAAA,MAC1B,OAAQ,QAAQ,MAAM,QAAQ,KAAK,MAAM,QAAQ,IAAI,QAAS,OAAO,MAAM,UAAU,WAAW,GAAG,MAAM,KAAK,OAAO,MAAM;AAAA,MAC3H,QAAQ,OAAO,MAAM,WAAW,WAAW,GAAG,MAAM,MAAM,OAAQ,MAAM,UAAU;AAAA,IAAA;;;QAK5E,OAAO,QAAA,QAAK,IAAA,wBAA+B;AAAA,MAAA;AAEjCA,oBAAA,QAAA,QAAL,MAAC;6BAEAC,eAAA,MAAM,IAAC,CAAA,CAAA;UACG,eAAe,QAAA,OAAO;AAAA;0HAQtC,EAAA,cAAA,wFAAA,kBAAA,cAAA,sBAAA,QAAA,6BAAA,QAAA,6BAAA,WAAA,CAAqO;;;;;;;;;;;;","names":["_ssrRenderList","_ssrRenderStyle"],"sources":["../../../../components/ui/Skeleton.vue"],"sourcesContent":["<script setup lang=\"ts\">\n/**\n * UiSkeleton — Astryx-style shimmer loading placeholder.\n * https://astryx.atmeta.com/components/Skeleton\n */\n\ninterface Props {\n  width?: string | number;\n  height?: string | number;\n  rounded?: 'none' | 'sm' | 'md' | 'full';\n  lines?: number;   // if > 1, renders stacked lines\n}\n\nconst props = withDefaults(defineProps<Props>(), {\n  rounded: 'sm',\n  lines: 1,\n});\n\nconst roundedClasses: Record<string, string> = {\n  none: 'rounded-none',\n  sm:   'rounded-[--ui-radius-sm]',\n  md:   'rounded-[--ui-radius-md]',\n  full: 'rounded-full',\n};\n\nconst style = (idx = 0) => ({\n  width:  idx === props.lines - 1 && props.lines > 1 ? '75%' : (typeof props.width === 'number' ? `${props.width}px` : props.width),\n  height: typeof props.height === 'number' ? `${props.height}px` : (props.height ?? '16px'),\n});\n</script>\n\n<template>\n  <div :class=\"lines > 1 ? 'flex flex-col gap-2' : undefined\">\n    <div\n      v-for=\"i in lines\"\n      :key=\"i\"\n      :style=\"style(i - 1)\"\n      :class=\"[\n        roundedClasses[rounded],\n        'relative overflow-hidden bg-[--ui-color-bg-muted]',\n      ]\"\n    >\n      <!-- Shimmer overlay -->\n      <div\n        class=\"absolute inset-0 -translate-x-full animate-[shimmer_1.4s_ease_infinite]\"\n        style=\"background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.18) 50%, transparent 100%); animation-name: ui-shimmer; animation-duration: 1.4s; animation-timing-function: ease; animation-iteration-count: infinite;\"\n      />\n    </div>\n  </div>\n</template>\n"],"version":3}