{"file":"index-CuaQbRi9.js","mappings":";;;;;;;;;;;;;;;;;;;;;AAKA,UAAM,QAAQ,SAAA;AACd,UAAM,OAAO,MAAM,OAAO;AAE1B,UAAM,EAAE,MAAM,aAAY,CAAA,QAAA,SAAA,IAAAA,iBAAA,MAAM;AAAA,MAA+B,cAAc,IAAI;AAAA;;KAAE;AACnF,UAAM,OAAO,SAAS,MAAM,KAAK,OAAO,IAAI;AAC5C,UAAM,SAAS,SAAsB,MAAM,KAAK,OAAO,UAAU,EAAE;;;AAI3D,YAAA,QAAAC,eAAAC,WAAA,EAAA,OAAM,+CAA2C,MAAA,CAAA,CAAA,wFAAA;;QAMrC,IAAG;AAAA,QAAS,OAAM;AAAA,MAAA;yBAA5B,CAAmG,GAAAC,QAAAC,UAAA,aAAA;;;;;8BAA3B,kBAAgB;AAAA,YAAA;AAAA;;;;mDACjDC,eAAAC,MAAA,IAAA,GAAM,KAAK,0CACdD,eAAAC,MAAA,MAAA,EAAO,MAAM,YAAcD,eAAAC,MAAA,IAAA,GAAM,QAAQ;;QAG5E,QAAQA,MAAA,IAAA,CAAI;AAAA,QACb,OAAM;AAAA,MAAA;yBAFR,CAKW,GAAAH,QAAAC,UAAA,aAAA;;;;;8BAFV,cAED;AAAA,YAAA;AAAA;;;;;oBAM2BE,MAAA,MAAA,GAAM,CAAvB,OAAO,UAAK;wOAMf,OAAO,QAAK,CAAA,EAAM,SAAQ,GAAA,GAAA,CAAA,6BAK5B,OAAK,MAAM,SAAS,kBACpB,OAAK,MAAM,KAAK,wHAMsBD,eAAA,MAAM,KAAK,gDACPA,eAAA,MAAM,QAAQ;sBAGpC,MAAM,SAAO,CAAvB,WAAM;;YAGyC,0BAAA,OAAO,WAAM;AAAA,YAA6D,wBAAA,OAAO,WAAM;AAAA,YAAuD,wBAAA,OAAO,WAAM;AAAA,UAAA,kFAM9MA,eAAA,OAAO,MAAM,OAASA,eAAA,OAAO,KAAK;;;;UAOxC,IAAE,UAAYC,MAAA,IAAA,CAAI,IAAI,MAAM,EAAE;AAAA,UAC/B,OAAM;AAAA,QAAA;2BAFR,CAKW,GAAAH,QAAAC,UAAA,aAAA;;;;;gCAFV,aAED;AAAA,cAAA;AAAA;;;;;;;;;;;;;;;;","names":["_withAsyncContext","_ssrRenderAttrs","_mergeProps","_push","_parent","_ssrInterpolate","_unref"],"sources":["../../../../pages/admin/[slug]/index.vue"],"sourcesContent":["<script setup lang=\"ts\">\nimport type { TourConfig, TourScene } from '~/types/tour';\n\ndefinePageMeta({ ssr: false });\n\nconst route = useRoute();\nconst slug = route.params.slug as string;\n\nconst { data, refresh } = await useFetch<{ item: TourConfig }>(`/api/tours/${slug}`);\nconst tour = computed(() => data.value?.item);\nconst scenes = computed<TourScene[]>(() => tour.value?.scenes ?? []);\n</script>\n\n<template>\n  <main class=\"min-h-screen bg-ink px-6 py-10 text-white\">\n    <div class=\"mx-auto max-w-5xl\">\n\n      <!-- Header -->\n      <div class=\"mb-8 flex items-end justify-between\">\n        <div>\n          <NuxtLink to=\"/admin\" class=\"text-xs text-white/40 hover:text-white/70\">← Danh sách tour</NuxtLink>\n          <h1 class=\"mt-2 text-2xl font-bold\">{{ tour?.title }}</h1>\n          <p class=\"text-sm text-white/40\">{{ scenes.length }} cảnh · {{ tour?.location }}</p>\n        </div>\n        <NuxtLink\n          :to=\"`/${slug}`\"\n          class=\"rounded-lg border border-white/15 px-4 py-2 text-sm text-white/60 hover:text-white transition\"\n        >\n          Xem tour →\n        </NuxtLink>\n      </div>\n\n      <!-- Scene list -->\n      <div class=\"space-y-3\">\n        <div\n          v-for=\"(scene, index) in scenes\"\n          :key=\"scene.id\"\n          class=\"group flex items-center gap-4 rounded-xl border border-white/10 bg-white/5 p-4 hover:border-river/40 transition-all\"\n        >\n          <!-- Index -->\n          <span class=\"w-7 shrink-0 text-center text-sm font-bold text-white/25\">\n            {{ String(index + 1).padStart(2, '0') }}\n          </span>\n\n          <!-- Thumbnail -->\n          <img\n            :src=\"scene.thumbnail\"\n            :alt=\"scene.title\"\n            class=\"h-16 w-28 shrink-0 rounded-lg object-cover\"\n          />\n\n          <!-- Info -->\n          <div class=\"min-w-0 flex-1\">\n            <p class=\"font-semibold text-white\">{{ scene.title }}</p>\n            <p class=\"mt-0.5 text-xs text-white/45\">{{ scene.subtitle }}</p>\n            <div class=\"mt-2 flex flex-wrap gap-1.5\">\n              <span\n                v-for=\"marker in scene.markers\"\n                :key=\"marker.id\"\n                class=\"rounded px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider\"\n                :class=\"{\n                  'bg-river/20 text-river': marker.plugin === 'navigation',\n                  'bg-clay/20 text-clay': marker.plugin === 'info',\n                  'bg-moss/20 text-moss': marker.plugin === 'audio',\n                }\"\n              >\n                {{ marker.plugin }} · {{ marker.label }}\n              </span>\n            </div>\n          </div>\n\n          <!-- Edit button -->\n          <NuxtLink\n            :to=\"`/admin/${slug}/${scene.id}`\"\n            class=\"shrink-0 rounded-lg border border-white/15 px-3 py-2 text-xs text-white/50 hover:border-river/50 hover:text-river transition-all\"\n          >\n            Chỉnh sửa\n          </NuxtLink>\n        </div>\n      </div>\n\n    </div>\n  </main>\n</template>\n"],"version":3}