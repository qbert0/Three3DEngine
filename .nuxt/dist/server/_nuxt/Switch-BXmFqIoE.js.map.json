{"file":"Switch-BXmFqIoE.js","mappings":";;;;;;;;;;;;;;AAmBA,UAAM,QAAQ;AAQd,UAAM,MAAM,MAAM,MAAM,UAAU,KAAK,OAAA,EAAS,SAAS,EAAE,EAAE,MAAM,GAAG,CAAC,CAAC;AAExE,UAAM,UAAU;AAAA,MACd,IAAI,EAAE,OAAO,WAAa,OAAO,eAAe,WAAW,kBAAA;AAAA,MAC3D,IAAI,EAAE,OAAO,YAAa,OAAO,eAAgB,WAAW,gBAAA;AAAA,IAAgB;AAG9E,UAAM,IAAI,SAAS,MAAM,QAAQ,MAAM,IAAI,CAAC;;;QAKvC,KAAKA,MAAA,GAAA;AAAA,QACL,OAAK;AAAA;UAAkD,QAAA,WAAQ,kCAAA;AAAA,QAAA;AAAA,4BAO7DC,cAAA,MAAID,MAAA,GAAA,CAAG,gCAGPC,cAAA,gBAAc,QAAA,UAAU,0BACd,QAAA,QAAQ,IAAA,cAAA;;;QAC0M,EAAA,MAAE;AAAA,QAAe,QAAA,aAAU,0BAAA;AAAA,MAAA;;;QAUxE,EAAA,MAAE;AAAA,QAAiB,QAAA,aAAa,EAAA,MAAE,YAAS;AAAA,MAAA;UASjN,QAAA,OAAK;iGAAgE,QAAA,KAAK,CAAA,SAAA;AAAA;;;;;;;;;;;;;;","names":["_unref","_ssrRenderAttr"],"sources":["../../../../components/ui/Switch.vue"],"sourcesContent":["<script setup lang=\"ts\">\n/**\n * UiSwitch — Astryx-style toggle switch.\n * https://astryx.atmeta.com/components/Switch\n *\n * v-model: boolean\n * Sizes: sm | md\n */\n\nimport { computed } from 'vue';\n\ninterface Props {\n  modelValue?: boolean;\n  disabled?: boolean;\n  size?: 'sm' | 'md';\n  label?: string;\n  id?: string;\n}\n\nconst props = withDefaults(defineProps<Props>(), {\n  modelValue: false,\n  disabled: false,\n  size: 'md',\n});\n\nconst emit = defineEmits<{ 'update:modelValue': [val: boolean] }>();\n\nconst uid = props.id ?? `switch-${Math.random().toString(36).slice(2, 8)}`;\n\nconst sizeMap = {\n  sm: { track: 'w-8 h-5',   thumb: 'h-3.5 w-3.5', translate: 'translate-x-3.5' },\n  md: { track: 'w-11 h-6',  thumb: 'h-4.5 w-4.5',  translate: 'translate-x-5' },\n};\n\nconst s = computed(() => sizeMap[props.size]);\n</script>\n\n<template>\n  <label\n    :for=\"uid\"\n    :class=\"[\n      'inline-flex items-center gap-3',\n      disabled ? 'opacity-50 cursor-not-allowed' : 'cursor-pointer',\n    ]\"\n  >\n    <!-- Track -->\n    <button\n      :id=\"uid\"\n      type=\"button\"\n      role=\"switch\"\n      :aria-checked=\"modelValue\"\n      :disabled=\"disabled\"\n      :class=\"[\n        'relative shrink-0 rounded-full transition-colors duration-[--ui-transition-base]',\n        'outline-none focus-visible:ring-2 focus-visible:ring-offset-1 focus-visible:ring-[--ui-color-brand]',\n        s.track,\n        modelValue ? 'bg-[--ui-color-brand]' : 'bg-[--ui-color-bg-muted] ring-1 ring-[--ui-color-border]',\n      ]\"\n      @click=\"!disabled && emit('update:modelValue', !modelValue)\"\n    >\n      <!-- Thumb -->\n      <span\n        :class=\"[\n          'absolute top-1/2 left-0.5 -translate-y-1/2 rounded-full bg-white shadow-sm',\n          'transition-transform duration-[--ui-transition-base]',\n          s.thumb,\n          modelValue ? s.translate : 'translate-x-0',\n        ]\"\n      />\n    </button>\n    <!-- Label -->\n    <span v-if=\"label\" class=\"text-sm text-[--ui-color-text-primary] select-none\">{{ label }}</span>\n    <slot />\n  </label>\n</template>\n"],"version":3}